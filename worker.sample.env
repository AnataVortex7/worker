# ─────────────────────────────────────────────────────────────────────────────
# TG Stream Worker — Environment Variables
# Copy to worker.env and fill in values
# ─────────────────────────────────────────────────────────────────────────────

# Telegram credentials — same as main server
API_ID=
API_HASH=
BOT_TOKEN=

# ⚠️  MUST be exactly same as main server's STREAM_SECRET
# Main server ने issue केलेले tokens हाच key वापरून decrypt होतात
# Generate: openssl rand -hex 32
STREAM_SECRET=

# Server
PORT=8080
DEV=false

# Stream performance tuning (optional — defaults are good)
STREAM_CONCURRENCY=4
STREAM_BUFFER_COUNT=8
STREAM_TIMEOUT_SEC=30
STREAM_MAX_RETRIES=3

# Session files (faster bot startup on restart)
USE_SESSION_FILE=true

# Extra bot tokens for better Telegram throughput (optional)
# प्रत्येक token वेगळ्या bot चा असावा (same BOT_TOKEN नाही)
# MULTI_TOKEN1=
# MULTI_TOKEN2=
