# ─────────────────────────────────────────────────────────────────────────────
# TG Stream Worker — Environment Variables
# Copy to worker.env and fill in values
# ─────────────────────────────────────────────────────────────────────────────

# Main server URL — worker startup ला इथे register करतो
# Example: https://my-main-server.koyeb.app
MAIN_SERVER_URL=

# This worker's own public URL — main server ला ping/health check साठी
# Koyeb वर APP_URL automatically set असतो (तो detect होतो)
# Manual set करायचं असेल तरच:
# WORKER_SELF_URL=https://my-worker.koyeb.app

# ⚠️  MUST match main server's STREAM_SECRET exactly
# Token decrypt करण्यासाठी लागतो
# Generate: openssl rand -hex 32
STREAM_SECRET=

# Server
PORT=8080
DEV=false

# Stream tuning (optional — defaults are good)
STREAM_CONCURRENCY=4
STREAM_BUFFER_COUNT=8
STREAM_TIMEOUT_SEC=30
STREAM_MAX_RETRIES=3

# ─────────────────────────────────────────────────────────────────────────────
# NOTE: API_ID, API_HASH, BOT_TOKEN, MULTI_TOKEN — इथे लागत नाहीत!
# Bot credentials main server च्या encrypted token मधूनच येतात.
# Worker एकदा deploy केला की त्याच्याकडे बघायचं काम नाही.
# ─────────────────────────────────────────────────────────────────────────────
